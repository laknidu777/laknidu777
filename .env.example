# ==============================================================================
# Docker Compose & Production Environment Variables Specification
# Copy this template to .env at repository root:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Container Configuration
POSTGRES_DB=myprofile
POSTGRES_USER=profile_user
POSTGRES_PASSWORD=local_dev_password

# External Host Port for PostgreSQL (Bound to 127.0.0.1 for local host tooling)
POSTGRES_HOST_PORT=5433

# Application Container Port
PORT=3000

# NextAuth v5 Secret (Required for production authentication)
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-secure-random-32-char-secret-in-production

# NextAuth Canonical URL
NEXTAUTH_URL=http://localhost:3000

# Internal Database URL (passed to app containers within Docker network)
DATABASE_URL=postgresql://profile_user:local_dev_password@postgres:5432/myprofile

# Host Database URL (for host-based scripts such as prisma migrate or seed)
DATABASE_URL_HOST=postgresql://profile_user:local_dev_password@localhost:5433/myprofile

# SMTP Credentials for OTP Password Reset (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
