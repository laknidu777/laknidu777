# ==============================================================================
# Portfolio & Admin Portal - Canonical Environment Variable Specification
# Copy this template to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
# Required in all environments.
# For local host dev with docker-compose: port 5433
# For container-to-container inside docker network: postgresql://profile_user:local_dev_password@postgres:5432/myprofile
DATABASE_URL="postgresql://profile_user:local_dev_password@localhost:5433/myprofile"

# NextAuth v5 Session Encryption Secret
# Required in production. Generate using: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-32-char-secret-in-production"

# Canonical URL for NextAuth & Callback redirects
# Local development default: http://localhost:3000
# Production: https://your-custom-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Application Server Port & Host Binding (Optional)
PORT=3000
HOSTNAME="0.0.0.0"

# ==============================================================================
# SMTP Email Dispatch (Optional - for Admin OTP Password Recovery)
# If omitted or unconfigured, OTPs will be displayed in server logs in dev mode.
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
# To generate a Gmail App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_PASS="your-app-password"
SMTP_FROM="Portfolio Admin <your-email@gmail.com>"
