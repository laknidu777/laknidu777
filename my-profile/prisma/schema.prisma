
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ProjectCategory {
  FREELANCE
  PERSONAL
  RESEARCH
  GAME
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  summary      String          @db.Text
  description  String          @db.Text
  category     ProjectCategory @default(PERSONAL)
  imageUrl     String?
  projectUrl   String?
  githubUrl    String?
  technologies String[]
  featured     Boolean         @default(false)
  published    Boolean         @default(false)
  sortOrder    Int             @default(0)
  client       String?
  role         String?
  impact       String?
  statusText   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, published, sortOrder])
  @@index([published, sortOrder])
}

model Experience {
  id             String    @id @default(cuid())
  company        String
  position       String
  location       String?
  description    String    @db.Text
  startDate      DateTime
  endDate        DateTime?
  current        Boolean   @default(false)
  employmentType String?
  technologies   String[]  @default([])
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sortOrder])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  level     Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, category])
  @@index([category, sortOrder])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

